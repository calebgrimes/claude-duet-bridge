{
  "name": "duet-bridge",
  "version": "1.0.0",
  "description": "Cloud mailbox connector between Claude Duet and Claude Code on the Mac",
  "scripts": {
    "dev": "rm -rf .wrangler/e2e-state && wrangler dev --local-protocol https --port 8787 --persist-to .wrangler/e2e-state",
    "test": "node test/e2e.mjs",
    "check": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "private": true
}
